server.port=8081
server.address=127.0.0.1

# postgres supabase (dev)
spring.datasource.url=jdbc:postgresql://<HOST>:<PORT>/postgres?sslmode=require&prepareThreshold=0
spring.datasource.username=<DB_USERNAME>
spring.datasource.password=<DB_PASSWORD>
spring.datasource.driver-class-name=org.postgresql.Driver

# jpa
spring.jpa.database-platform=org.hibernate.dialect.PostgreSQLDialect
spring.jpa.hibernate.ddl-auto=validate
spring.jpa.show-sql=false

# app
app.url=http://localhost:8081
app.upload.path=file:///C:/uploads/

# mercado pago — credenciales de la app "MS2Version" en el panel de desarrolladores de MP (Marketplace/OAuth)
mercado.pago.client.id=<MERCADO_PAGO_CLIENT_ID>
mercado.pago.client.secret=<MERCADO_PAGO_CLIENT_SECRET>

# mail
spring.mail.host=smtp.gmail.com
spring.mail.port=587
spring.mail.properties.mail.smtp.auth=true
spring.mail.properties.mail.smtp.starttls.enable=true
spring.mail.username=<GMAIL_USERNAME>
spring.mail.password=<GMAIL_APP_PASSWORD>

# logs
logging.level.com.example.MarketS=DEBUG
logging.level.org.hibernate.SQL=ERROR

# JWT
jwt.secret=<JWT_SECRET_BASE64>

# CORS (React dev servers)
cors.allowed-origins=http://localhost:3000,http://localhost:5173

# Cookie JWT (dev: false/Lax — prod: true/None)
cookie.secure=false
cookie.samesite=Lax

# Supabase Storage
supabase.url=https://<SUPABASE_PROJECT_ID>.supabase.co
supabase.key=<SUPABASE_SERVICE_ROLE_KEY>
supabase.bucket=productos
